  "reviews": [
    {
      "id": "rev-01",
      "author": "R. Revathi",
      "location": "Orathanadu, Thanjavur",
      "crop": "Cauvery Samba Paddy",
      "rating": 5,
      "date": "2026-10-18",
      "avatar": "https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=200&q=80",
      "verifiedFarmer": true,
      "title": "Yield jumped from 28 bags to 38 bags per acre in Thanjavur!",
      "comment": "In the Cauvery delta, water management during monsoon is our biggest headache. Sanofar Fathima's Smart Agricultural System automatically closed my sluice gate when moisture crossed 80%, saving my standing CR 1009 crop from root rot. The live land report is a blessing for Tamil Nadu delta farmers!"
    },
    {
